{
  "name": "dsh-prompt-hone",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "description": "Polish the DSH composer draft into a clearer, executable prompt, in place.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "prompts.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "keywords": [
    "dsh-plugin",
    "prompt",
    "prompt-engineering",
    "prompt-optimization",
    "prompt-hone"
  ]
}
